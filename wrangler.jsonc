{
  "name": "gyajokpub",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/foto/*"]
  },
  "r2_buckets": [{ "binding": "FOTO", "bucket_name": "gyajokpub-foto" }],
  "triggers": { "crons": ["*/5 * * * *"] }
}